# Supabase project (Project Settings -> API). The service role key is used on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared passcode for the passcode screen. Changing it logs out every browser.
APP_PASSCODE=choose-a-long-passcode

# Sent as mailto in the User-Agent / query string (polite pools at OpenAlex and Crossref).
CONTACT_EMAIL=you@example.org

# OpenAlex API key (free: https://openalex.org/settings/api). Strongly recommended: without one,
# requests share a small per-IP daily budget that is often exhausted on cloud hosts.
OPENALEX_API_KEY=
